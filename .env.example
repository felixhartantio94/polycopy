# Privy Configuration
# Get these from https://dashboard.privy.io/
# The App ID is public and safe to expose to the client
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# The App Secret must NEVER be exposed to the client - only use in server-side code
PRIVY_APP_SECRET=your_privy_app_secret_here

# Node Environment
NODE_ENV=development
